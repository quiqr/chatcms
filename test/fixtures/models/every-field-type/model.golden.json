{
  "model": {
    "ssgType": "hugo",
    "ssgVersion": "0.110.0",
    "singles": [
      {
        "key": "kitchen-sink",
        "title": "Every field type",
        "file": "content/_index.md",
        "dataformat": "yaml",
        "fields": [
          {
            "key": "title",
            "type": "string",
            "title": "Title",
            "tip": "The name of this page",
            "config": {}
          },
          {
            "key": "summary",
            "type": "string",
            "title": "Summary",
            "config": {
              "multiLine": true,
              "txtInsertButtons": [
                "\u0026nbsp;"
              ]
            }
          },
          {
            "key": "body",
            "type": "markdown",
            "title": "Body"
          },
          {
            "key": "notes",
            "type": "easymde",
            "config": {
              "multiLine": true
            }
          },
          {
            "key": "slug",
            "type": "readonly",
            "config": {}
          },
          {
            "key": "id",
            "type": "uniq",
            "config": {}
          },
          {
            "key": "weight",
            "type": "number",
            "config": {
              "min": 0,
              "max": 100,
              "step": 5
            }
          },
          {
            "key": "prominence",
            "type": "slider",
            "config": {
              "min": 0,
              "max": 10,
              "step": 1
            }
          },
          {
            "key": "published",
            "type": "boolean",
            "default": false
          },
          {
            "key": "date",
            "type": "date",
            "config": {
              "dateFormat": "YYYY-MM-DD",
              "time": true
            }
          },
          {
            "key": "layout",
            "type": "select",
            "config": {
              "options": [
                {
                  "value": "plain"
                },
                {
                  "value": "wide",
                  "text": "Wide"
                }
              ],
              "option_image_path": "static/layouts",
              "option_image_width": 120,
              "option_image_extension": "png"
            }
          },
          {
            "key": "related",
            "type": "select-from-query",
            "config": {
              "query_glob": "content/posts/**/*.md",
              "query_string": ".title",
              "multiple": true
            }
          },
          {
            "key": "tags",
            "type": "chips",
            "config": {
              "options": [
                {
                  "value": "news"
                },
                {
                  "value": "events"
                }
              ]
            }
          },
          {
            "key": "accent",
            "type": "color"
          },
          {
            "key": "heading_font",
            "type": "font-picker",
            "config": {
              "limit": 20,
              "categories": [
                "sans-serif"
              ]
            }
          },
          {
            "key": "icon",
            "type": "fonticon-picker",
            "config": {}
          },
          {
            "key": "hero",
            "type": "image-select",
            "config": {
              "path": "static/images",
              "buttonTitle": "Choose an image",
              "extensions": [
                "jpg",
                "png"
              ]
            }
          },
          {
            "key": "priorities",
            "type": "eisenhouwer",
            "config": {
              "dataSetsPath": "data.sets",
              "dataSetsDataPointsPath": "points",
              "dataSetsDataPointPosXPath": "x",
              "dataSetsDataPointPosYPath": "y",
              "xScaleTitle": "Urgency",
              "yScaleTitle": "Importance"
            }
          },
          {
            "key": "seo",
            "type": "section",
            "title": "Search engines and sharing",
            "fields": [
              {
                "key": "description",
                "type": "string",
                "config": {}
              },
              {
                "key": "noindex",
                "type": "boolean"
              }
            ],
            "config": {}
          },
          {
            "key": "tree",
            "type": "nest",
            "fields": [
              {
                "key": "label",
                "type": "string",
                "config": {}
              }
            ],
            "config": {
              "max_depth": 3
            }
          },
          {
            "key": "blocks",
            "type": "accordion",
            "fields": [
              {
                "key": "heading",
                "type": "string",
                "arrayTitle": true,
                "config": {}
              },
              {
                "key": "text",
                "type": "markdown"
              }
            ],
            "config": {
              "disableSort": true
            }
          },
          {
            "key": "meta",
            "type": "pull",
            "group": "metadata",
            "fields": [
              {
                "key": "author",
                "type": "string",
                "config": {}
              }
            ],
            "config": {
              "group": "metadata"
            }
          },
          {
            "key": "keywords",
            "type": "leaf-array",
            "config": {
              "field": {
                "key": "keyword",
                "type": "string",
                "config": {}
              }
            }
          },
          {
            "key": "gallery",
            "type": "bundle-manager",
            "fields": [
              {
                "key": "caption",
                "type": "string",
                "config": {}
              },
              {
                "key": "thumb",
                "type": "bundle-image-thumbnail",
                "config": {
                  "src": "thumb.png"
                }
              }
            ],
            "config": {
              "path": "gallery",
              "maxItems": 12
            }
          },
          {
            "key": "internal_id",
            "type": "hidden",
            "default": "generated"
          },
          {
            "key": "spacer",
            "type": "empty-line",
            "config": {
              "amount": 2
            }
          },
          {
            "key": "guidance",
            "type": "info",
            "content": "Fill in the title first.",
            "theme": "warn",
            "config": {
              "content": "Fill in the title first.",
              "size": "small"
            }
          },
          {
            "key": "rating",
            "type": "unknown",
            "config": {
              "declaredType": "star-rating",
              "properties": {
                "maximum": 5
              }
            }
          }
        ]
      }
    ],
    "baseFile": "quiqr/model/base.yaml"
  },
  "navigation": {
    "sections": [
      {
        "title": "Pages",
        "entries": [
          {
            "key": "kitchen-sink",
            "title": "Every field type",
            "kind": "page"
          }
        ]
      }
    ]
  }
}
