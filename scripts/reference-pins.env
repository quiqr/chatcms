# What the reference instance is.
#
# Every line here decides what the old Quiqr answers. Moving one is a
# deliberate act: an answer recorded under test/fixtures/reference/ that
# changes afterwards changed because of an edit in this file, and the commit
# that moves a pin says which answers moved with it.

# The application whose behaviour ChatCMS promises to reproduce. The
# organisation's repository, not a fork: mipmip/quiqr-desktop is ahead of it
# by one commit, which exports libstdc++ in that repository's own dev shell,
# and reference.sh exports it for itself instead.
REFERENCE_APP_REMOTE=https://github.com/quiqr/quiqr-desktop
REFERENCE_APP_COMMIT=51b24ce9d7daaf7903383af487ae80b164077f66

# The site it edits. The kitchen sink declares 26 of the 28 field types the
# old application draws, including every type ChatCMS currently falls back to
# a plain text box for.
REFERENCE_SITE_REMOTE=https://github.com/quiqr/quiqr-template-kitchen-sink
REFERENCE_SITE_COMMIT=20ef718c088137014b55317c66386309dffb0b9f
REFERENCE_SITE_KEY=kitchen-sink
REFERENCE_SITE_NAME="Kitchen Sink"

# Away from the old application's own defaults (5150 and 13131), so that a
# Quiqr somebody is already running does not have to be stopped first.
REFERENCE_PORT=5160
REFERENCE_PREVIEW_PORT=13141

# Who signs in. Nothing here is a secret: the instance holds a public
# template and listens on the loopback address.
REFERENCE_USER=reference@example.org
REFERENCE_PASSWORD="a long enough passphrase"
